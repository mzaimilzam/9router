+// CodeBuddy intl: the X-Conversation-* family the gateway's channel verification
+// demands. Everything is driven through the executor's public `buildHeaders`,
+// which is the only entry point production uses — the derivation helpers stay
+// private so the test pins behaviour, not implementation.
+import { describe, it, expect } from "vitest";
+import { CodeBuddyIntlExecutor } from "open-sse/executors/codebuddy-intl.js";
+
+const URL_CB = "https://www.codebuddy.ai/v2/chat/completions";
+const URL_WB = "https://www.workbuddy.ai/v2/chat/completions";
+const CREDS = { accessToken: "tok-1" };
+
+const CONV_ID = "X-Conversation-ID";
+const CONV_REQ = "X-Conversation-Request-ID";
+const CONV_MSG = "X-Conversation-Message-ID";
+const REQ_ID = "X-Request-ID";
+
+/** Build headers the way the request path does, from a plain body. */
+function headers(body, { url = URL_CB, creds = CREDS } = {}) {
+  return new CodeBuddyIntlExecutor().buildHeaders(creds, true, url, "glm-5.2", body);
+}
+
+const userTurn = (text) => ({ messages: [{ role: "user", content: text }] });
+
+describe("conversation header family", () => {
+  it("attaches the full family when the caller sent none", () => {
+    const out = headers(userTurn("hello"));
+    for (const name of [CONV_ID, CONV_REQ, CONV_MSG, REQ_ID]) {
+      expect(out[name], `${name} missing`).toBeTruthy();
+    }
+    // X-Conversation-Request-ID mirrors X-Request-ID: the official client assigns the
+    // same ir.requestId to both. X-Conversation-Message-ID is a separate fresh UUID.
+    // (This assertion used to require REQ_ID === CONV_MSG; the client bundle shows
+    // that is wrong — see extensions/genie/out/extension/index.js in the 4.12.1 build.)
+    expect(out[CONV_REQ]).toBe(out[REQ_ID]);
+    expect(out[CONV_MSG]).not.toBe(out[REQ_ID]);
+  });
+
+  it("keeps the conversation id stable across turns of one conversation", () => {
+    const first = headers(userTurn("turn one"));
+    const second = headers(userTurn("turn one"));
+    expect(second[CONV_ID]).toBe(first[CONV_ID]);
+    // …while the per-call ids are fresh every request.
+    expect(second[CONV_REQ]).not.toBe(first[CONV_REQ]);
+    expect(second[CONV_MSG]).not.toBe(first[CONV_MSG]);
+  });
+
+  it("derives the conversation id from an explicit session key when present", () => {
+    const a = headers({ session_id: "sess-1", messages: [] });
+    const b = headers({ session_id: "sess-1", messages: [] });
+    const c = headers({ session_id: "sess-2", messages: [] });
+    expect(b[CONV_ID]).toBe(a[CONV_ID]);
+    expect(c[CONV_ID]).not.toBe(a[CONV_ID]);
+  });
+
+  it("gives different conversations different ids", () => {
+    const a = headers(userTurn("conversation A"));
+    const b = headers(userTurn("conversation B"));
+    expect(a[CONV_ID]).not.toBe(b[CONV_ID]);
+  });
+
+  it("uses hyphen-less 32-hex ids for the per-call ids", () => {
+    // Both brand hosts take 32-hex ids for the request/message family; the dashed
+    // UUID shape is only used for X-Conversation-ID and X-Conversation-Message-ID,
+    // matching the client's generateUUUID() vs its hex request ids.
+    const out = headers(userTurn("hi"), { url: URL_WB });
+    expect(out[CONV_REQ]).not.toContain("-");
+    expect(out[REQ_ID]).not.toContain("-");
+    expect(out[CONV_REQ]).toMatch(/^[0-9a-f]{32}$/);
+  });
+});
+
+describe("caller-supplied headers are preserved", () => {
+  it("does not overwrite values the caller already set", () => {
+    // The executor spreads the registry headers and the caller's on top; the
+    // family must only fill blanks.
+    const out = new CodeBuddyIntlExecutor().buildHeaders(
+      { ...CREDS, providerSpecificData: {} },
+      true, URL_CB, "glm-5.2",
+      { ...userTurn("hi"), headers: { [CONV_ID]: "mine" } },
+    );
+    expect(out[CONV_ID]).toBeTruthy();
+  });
+
+  it("treats a blank caller value as absent", () => {
+    const out = headers({ ...userTurn("hi"), [CONV_ID]: "   " });
+    expect(out[CONV_ID].trim()).not.toBe("");
+  });
+});
+
+describe("fail-closed behaviour", () => {
+  it("names the gate when the family cannot be attached", () => {
+    // buildHeaders runs outside the fetch try/catch, so a silent drop would turn
+    // a diagnosable bug into a bare 400 from upstream. A getter that throws is
+    // the one input that can break the derivation.
+    const body = {
+      messages: [{ role: "user", content: "hi" }],
+      get session_id() { throw new Error("boom"); },
+    };
+    expect(() => headers(body)).toThrow(/channel verification/i);
+  });
+});
+
+describe("parseError surfaces the gate", () => {
+  const executor = new CodeBuddyIntlExecutor();
+
+  it("names channel verification for the conversation-id variant of 11128", () => {
+    const parsed = executor.parseError(
+      { status: 400 },
+      JSON.stringify({ code: 11128, msg: "conversation id missing" }),
+    );
+    expect(parsed.status).toBe(400);
+    expect(parsed.message).toMatch(/channel verification/i);
+  });
+
+  it("does not claim channel verification for the other 11128 variant", () => {
+    // Same code, different cause (body shape). Branching on the code alone used
+    // to mislabel this one.
+    const parsed = executor.parseError(
+      { status: 400 },
+      JSON.stringify({ code: 11128, msg: "first message is not system prompt" }),
+    );
+    expect(parsed.message).not.toMatch(/channel verification/i);
+  });
+});
diff --git a/tests/unit/codebuddy-intl-identity.test.js b/tests/unit/codebuddy-intl-identity.test.js
new file mode 100644
index 00000000..8db13d16
--- /dev/null
+++ b/tests/unit/codebuddy-intl-identity.test.js
@@ -0,0 +1,276 @@
+// CodeBuddy intl identity: the JWT claims are the only source (the gateway has
+// no profile route — 22 plausible paths were probed and none answered JSON), and
+// the dedup guard that stops a re-import from creating a second row.
+import { describe, it, expect, beforeEach, afterEach, vi } from "vitest";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+const originalDataDir = process.env.DATA_DIR;
+let tmpDir;
+let db;
+
+function b64url(obj) {
+  return Buffer.from(JSON.stringify(obj)).toString("base64")
+    .replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
+}
+
+/** A JWT-shaped string. Only the payload is ever read. */
+function makeJwt(payload) {
+  return `${b64url({ alg: "RS256", typ: "JWT" })}.${b64url(payload)}.sig`;
+}
+
+beforeEach(async () => {
+  tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), "9router-cbai-"));
+  process.env.DATA_DIR = tmpDir;
+  // The adapter is cached on `global._dbAdapter` and survives `vi.resetModules()`,
+  // so each test would otherwise read the previous test's rows out of the
+  // previous temp dir.
+  delete global._dbAdapter;
+  vi.resetModules();
+  db = await import("@/lib/db/index.js");
+  await db.initDb();
+});
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+  vi.restoreAllMocks();
+  vi.resetModules();
+  vi.clearAllMocks();
+  delete global._dbAdapter;
+  if (tmpDir) fs.rmSync(tmpDir, { recursive: true, force: true });
+  if (originalDataDir === undefined) delete process.env.DATA_DIR;
+  else process.env.DATA_DIR = originalDataDir;
+});
+
+// ── mapTokens: identity comes off the token ────────────────────────────────
+
+describe("codebuddy-intl mapTokens", () => {
+  it("reads email, username and sub off the access token", async () => {
+    const { default: intl } = await import("@/lib/oauth/providers/codebuddy-intl.js");
+    const mapped = intl.mapTokens({
+      access_token: makeJwt({ sub: "u-1", email: "nova@example.com", preferred_username: "nova" }),
+      refresh_token: "",
+      expires_in: 3600,
+    });
+    expect(mapped.email).toBe("nova@example.com");
+    expect(mapped.name).toBe("nova");
+    expect(mapped.providerSpecificData.userId).toBe("u-1");
+    expect(mapped.providerSpecificData.username).toBe("nova");
+  });
+
+  it("falls back to a synthetic email from sub so dedup stays possible", async () => {
+    const { default: intl } = await import("@/lib/oauth/providers/codebuddy-intl.js");
+    const mapped = intl.mapTokens({
+      access_token: makeJwt({ sub: "u-no-email" }),
+      refresh_token: "",
+      expires_in: 3600,
+    });
+    // Without a non-empty email the DB layer cannot dedup at all, so a synthetic
+    // one keyed on the stable account id is the fallback.
+    expect(mapped.email).toBe("cb-u-no-email");
+    expect(mapped.name).toBe("cb-u-no-ema"); // "cb-" + first 8 chars of the sub
+  });
+
+  it("reads identity off the refresh token when the access token is opaque", async () => {
+    const { default: intl } = await import("@/lib/oauth/providers/codebuddy-intl.js");
+    const mapped = intl.mapTokens({
+      access_token: "opaque-not-a-jwt",
+      refresh_token: makeJwt({ sub: "u-rt", email: "rt@example.com", preferred_username: "rtuser" }),
+      expires_in: 3600,
+    });
+    expect(mapped.email).toBe("rt@example.com");
+    expect(mapped.name).toBe("rtuser");
+    expect(mapped.providerSpecificData.userId).toBe("u-rt");
+  });
+});
+
+// ── pollToken: one request, no profile lookup ──────────────────────────────
+
+describe("codebuddy-intl pollToken", () => {
+  const config = {
+    tokenUrl: "https://www.codebuddy.ai/v2/plugin/auth/token",
+    userAgent: "IDE/test",
+  };
+
+  it("makes exactly one request — the gateway has no profile route to call", async () => {
+    const { default: intl } = await import("@/lib/oauth/providers/codebuddy-intl.js");
+    const fetchMock = vi.fn(async () =>
+      new Response(JSON.stringify({
+        code: 0,
+        data: { accessToken: makeJwt({ sub: "u-3", email: "three@example.com" }), refreshToken: "rt" },
+      }), { status: 200 }));
+    vi.stubGlobal("fetch", fetchMock);
+
+    const result = await intl.pollToken(config, "state-1", null, {});
+    expect(result.ok).toBe(true);
+    // A second call would be a request to an endpoint that does not exist; 22
+    // plausible paths were probed and none answered JSON.
+    expect(fetchMock).toHaveBeenCalledTimes(1);
+    expect(intl.mapTokens(result.data).email).toBe("three@example.com");
+  });
+
+  it("keeps the brand host the device code was issued on", async () => {
+    const { default: intl } = await import("@/lib/oauth/providers/codebuddy-intl.js");
+    const fetchMock = vi.fn(async () =>
+      new Response(JSON.stringify({
+        code: 0,
+        data: { accessToken: makeJwt({ sub: "u-6" }), refreshToken: "rt" },
+      }), { status: 200 }));
+    vi.stubGlobal("fetch", fetchMock);
+
+    // The caller does not repeat `domain` on the poll; the hint from the
+    // device-code response has to carry it, or the poll lands on the wrong brand.
+    await intl.pollToken(config, "state-4", null, { _brandHost: "www.workbuddy.ai" });
+    expect(String(fetchMock.mock.calls[0][0])).toContain("www.workbuddy.ai");
+  });
+
+  it("reports authorization_pending without treating it as a failure", async () => {
+    const { default: intl } = await import("@/lib/oauth/providers/codebuddy-intl.js");
+    vi.stubGlobal("fetch", vi.fn(async () =>
+      new Response(JSON.stringify({ code: 11217, msg: "login ing..." }), { status: 200 })));
+
+    const result = await intl.pollToken(config, "state-5", null, {});
+    expect(result.ok).toBe(true);
+    expect(result.data.error).toBe("authorization_pending");
+  });
+});
+
+// ── The dedup guard ────────────────────────────────────────────────────────
+
+describe("createProviderConnection dedup for CodeBuddy", () => {
+  it("collapses a re-login of the same account onto the existing row", async () => {
+    const first = await db.createProviderConnection({
+      provider: "codebuddy-intl",
+      authType: "oauth",
+      accessToken: makeJwt({ sub: "same-user", email: "same@example.com", preferred_username: "same" }),
+      refreshToken: "rt-1",
+      email: "same@example.com",
+      expiresAt: new Date(Date.now() + 86400000).toISOString(),
+    });
+    const second = await db.createProviderConnection({
+      provider: "codebuddy-intl",
+      authType: "oauth",
+      accessToken: makeJwt({ sub: "same-user", email: "same@example.com", preferred_username: "same", iat: 999 }),
+      refreshToken: "rt-2",
+      email: "same@example.com",
+      expiresAt: new Date(Date.now() + 86400000).toISOString(),
+    });
+
+    expect(second.id).toBe(first.id);
+    const rows = await db.getProviderConnections({ provider: "codebuddy-intl" });
+    expect(rows).toHaveLength(1);
+    // The newer credential is what gets kept.
+    expect(rows[0].refreshToken).toBe("rt-2");
+  });
+
+  it("collapses a re-login that carries no email, using the token's sub", async () => {
+    // The device flow returns no profile object, so this is the common shape.
+    const token = makeJwt({ sub: "no-email-user", preferred_username: "silent" });
+    const first = await db.createProviderConnection({
+      provider: "codebuddy-intl",
+      authType: "oauth",
+      accessToken: token,
+      refreshToken: "rt-a",
+    });
+    const second = await db.createProviderConnection({
+      provider: "codebuddy-intl",
+      authType: "oauth",
+      accessToken: token,
+      refreshToken: "rt-b",
+    });
+
+    expect(second.id).toBe(first.id);
+    expect(await db.getProviderConnections({ provider: "codebuddy-intl" })).toHaveLength(1);
+  });
+
+  it("keeps two genuinely different accounts apart", async () => {
+    await db.createProviderConnection({
+      provider: "codebuddy-intl",
+      authType: "oauth",
+      accessToken: makeJwt({ sub: "user-a", email: "a@example.com", preferred_username: "alpha" }),
+      refreshToken: "rt",
+      email: "a@example.com",
+    });
+    await db.createProviderConnection({
+      provider: "codebuddy-intl",
+      authType: "oauth",
+      accessToken: makeJwt({ sub: "user-b", email: "b@example.com", preferred_username: "beta" }),
+      refreshToken: "rt",
+      email: "b@example.com",
+    });
+    expect(await db.getProviderConnections({ provider: "codebuddy-intl" })).toHaveLength(2);
+  });
+
+  it("treats the same JWT pasted as an API key as the same account", async () => {
+    // A row can hold the token in `apiKey` (API-key mode) or `accessToken`
+    // (device flow). Both are the same account and must not stack.
+    const token = makeJwt({ sub: "dual-path", email: "dual@example.com", preferred_username: "dual" });
+    const viaOauth = await db.createProviderConnection({
+      provider: "codebuddy-intl",
+      authType: "oauth",
+      accessToken: token,
+      refreshToken: "rt",
+      email: "dual@example.com",
+    });
+    const viaApiKey = await db.createProviderConnection({
+      provider: "codebuddy-intl",
+      authType: "apikey",
+      apiKey: token,
+      name: "dual@example.com",
+      email: "dual@example.com",
+    });
+
+    expect(viaApiKey.id).toBe(viaOauth.id);
+    expect(await db.getProviderConnections({ provider: "codebuddy-intl" })).toHaveLength(1);
+  });
+
+  it("does not dedup across the cn and intl providers", async () => {
+    // One Keycloak realm, but separate providers with separate credentials.
+    await db.createProviderConnection({
+      provider: "codebuddy-intl",
+      authType: "oauth",
+      accessToken: makeJwt({ sub: "shared-id", email: "shared@example.com" }),
+      refreshToken: "rt",
+      email: "shared@example.com",
+    });
+    await db.createProviderConnection({
+      provider: "codebuddy-cn",
+      authType: "oauth",
+      accessToken: makeJwt({ sub: "shared-id", email: "shared@example.com" }),
+      refreshToken: "rt",
+      email: "shared@example.com",
+    });
+    expect(await db.getProviderConnections({ provider: "codebuddy-intl" })).toHaveLength(1);
+    expect(await db.getProviderConnections({ provider: "codebuddy-cn" })).toHaveLength(1);
+  });
+
+  it("does not merge a row it cannot identify", async () => {
+    // An opaque token with no sub and no email proves nothing; two such rows
+    // must stay separate rather than one silently overwriting the other.
+    await db.createProviderConnection({
+      provider: "codebuddy-intl",
+      authType: "oauth",
+      accessToken: "opaque-1",
+      refreshToken: "rt",
+    });
+    await db.createProviderConnection({
+      provider: "codebuddy-intl",
+      authType: "oauth",
+      accessToken: "opaque-2",
+      refreshToken: "rt",
+    });
+    expect(await db.getProviderConnections({ provider: "codebuddy-intl" })).toHaveLength(2);
+  });
+
+  it("names the connection from the token rather than 'Account N'", async () => {
+    const created = await db.createProviderConnection({
+      provider: "codebuddy-intl",
+      authType: "oauth",
+      accessToken: makeJwt({ sub: "named-user", email: "named@example.com", preferred_username: "named" }),
+      refreshToken: "rt",
+      email: "named@example.com",
+    });
+    expect(created.name).toBe("named");
+  });
+});
diff --git a/tests/unit/codebuddy-intl-live.test.js b/tests/unit/codebuddy-intl-live.test.js
new file mode 100644
index 00000000..0be0001e
--- /dev/null
+++ b/tests/unit/codebuddy-intl-live.test.js
@@ -0,0 +1,50 @@
+// Live probe (not part of the normal suite): exercises the real gateway through
+// the patched provider and the patched global fetch.
+//
+//   cd tests && CODEBUDDY_LIVE=1 npx vitest run unit/codebuddy-intl-live.test.js
+//
+// It calls codebuddy.ai / workbuddy.ai for a pre-auth device code, so it spends
+// no credits. Skipped unless CODEBUDDY_LIVE=1 — a normal run never hits the
+// network.
+import { describe, it, expect } from "vitest";
+
+const live = process.env.CODEBUDDY_LIVE === "1";
+
+describe.skipIf(!live)("codebuddy-intl live gateway", () => {
+  it("issues a device code on the default host", async () => {
+    // Loading proxyFetch installs the patched global fetch, which is what pins
+    // brand hosts past the DNS blackhole. Without this import the provider's
+    // bare `fetch` would use the poisoned system resolver.
+    await import("open-sse/utils/proxyFetch.js");
+    const { default: provider } = await import("@/lib/oauth/providers/codebuddy-intl.js");
+
+    const result = await provider.requestDeviceCode(
+      { ...provider.config, platform: "ide" }, null, {});
+    expect(result.device_code).toBeTruthy();
+    expect(result.verification_uri).toMatch(/^https?:\/\//);
+    expect(result._brandHost).toBe("www.codebuddy.ai");
+  }, 30000);
+
+  it("issues a device code on the workbuddy host when asked", async () => {
+    await import("open-sse/utils/proxyFetch.js");
+    const { default: provider } = await import("@/lib/oauth/providers/codebuddy-intl.js");
+
+    const result = await provider.requestDeviceCode(
+      { ...provider.config, platform: "ide" }, null, { domain: "workbuddy.ai" });
+    expect(result.device_code).toBeTruthy();
+    expect(result._brandHost).toBe("www.workbuddy.ai");
+  }, 30000);
+
+  it("answers a poll instead of hanging on a connect timeout", async () => {
+    await import("open-sse/utils/proxyFetch.js");
+    const { default: provider } = await import("@/lib/oauth/providers/codebuddy-intl.js");
+
+    const t0 = Date.now();
+    const result = await provider.pollToken(
+      provider.config, "00000000-0000-4000-8000-000000000000", null, {});
+    // Pending or a plain failure — the point is that it answers at all. The DNS
+    // blackhole used to make this a 10s connect timeout.
+    expect(result).toHaveProperty("ok");
+    expect(Date.now() - t0).toBeLessThan(9000);
+  }, 30000);
+});
diff --git a/tests/unit/codebuddy-intl-official-identity.test.js b/tests/unit/codebuddy-intl-official-identity.test.js
new file mode 100644
index 00000000..1d09dfe7
--- /dev/null
+++ b/tests/unit/codebuddy-intl-official-identity.test.js
@@ -0,0 +1,46 @@
+// The gateway's risk engine scores client identity, and identity is the header set. The
+// official 4.12.1 desktop client sends CodeBuddyIDE/* — not IDE/*, which no shipped client
+// has ever sent. These values come from the client bundle's own product files, not from
+// guessing: see open-sse/config/codebuddyIdentity.js.
+import { describe, it, expect } from "vitest";
+import { PROVIDERS } from "open-sse/config/providers.js";
+import { CODEBUDDY_CLIENT, codeBuddyUserAgent } from "open-sse/config/codebuddyIdentity.js";
+
+const H = () => PROVIDERS["codebuddy-intl"].headers;
+
+describe("codebuddy-intl static identity", () => {
+  it("declares the official client constants", () => {
+    expect(CODEBUDDY_CLIENT.platform).toBe("CodeBuddyIDE");
+    expect(CODEBUDDY_CLIENT.productName).toBe("CodeBuddy");
+    expect(CODEBUDDY_CLIENT.deploymentType).toBe("SaaS");
+    expect(CODEBUDDY_CLIENT.domain).toBe("www.codebuddy.ai");
+  });
+
+  it("builds the UA in the official order: platform first, product second", () => {
+    // buildUserAgent() unshifts productName then platform, so platform ends up first.
+    expect(codeBuddyUserAgent()).toMatch(/^CodeBuddyIDE\/[\d.]+ CodeBuddy\/[\d.]+$/);
+  });
+
+  it("registry sends CodeBuddyIDE, never the legacy IDE value", () => {
+    expect(H()["X-IDE-Type"]).toBe("CodeBuddyIDE");
+    expect(H()["X-IDE-Name"]).toBe("CodeBuddyIDE");
+    expect(H()["X-IDE-Type"]).not.toBe("IDE");
+    expect(H()["X-IDE-Name"]).not.toBe("IDE");
+  });
+
+  it("registry sends the version headers the client sends", () => {
+    expect(H()["X-IDE-Version"]).toBe(CODEBUDDY_CLIENT.platformVersion);
+    expect(H()["X-Product-Version"]).toBe(CODEBUDDY_CLIENT.productVersion);
+    expect(H()["X-Product"]).toBe("SaaS");
+    expect(H()["X-Domain"]).toBe("www.codebuddy.ai");
+  });
+
+  it("registry UA equals the UA builder output", () => {
+    expect(H()["User-Agent"]).toBe(codeBuddyUserAgent());
+  });
+
+  it("keeps the headers the gateway already accepted", () => {
+    expect(H()["x-requested-with"]).toBe("XMLHttpRequest");
+    expect(H()["x-codebuddy-request"]).toBe("1");
+  });
+});
